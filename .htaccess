# Enable mod_rewrite
RewriteEngine On

# Set base URL for rewriting
RewriteBase /

# Prevent direct access to sensitive files/directories
RewriteRule ^(config|includes|database|\.git) - [F,L]

# If the request is for a file that exists, serve it
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# If the request is for a directory that exists, serve it
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise, route all requests to index.php for handling
RewriteRule ^(.*)$ index.php [QSA,L]

# Set proper headers for PHP files
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>

# Disable directory listing
Options -Indexes

# Set default index files
DirectoryIndex index.php index.html
